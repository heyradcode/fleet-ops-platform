{
  "name": "meridian-fleet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Meridian - a real-time fleet dispatch platform. MVP-scale reference implementation on AWS serverless, runnable offline.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/demo.ts",
    "dev": "nodemon",
    "demo:auth": "node src/demo.ts --only=auth",
    "demo:ingest": "node src/demo.ts --only=ingest",
    "demo:scenarios": "node src/demo.ts --only=scenarios",
    "demo:data": "node src/demo.ts --only=data",
    "demo:events": "node src/demo.ts --only=events",
    "demo:graphql": "node src/demo.ts --only=graphql",
    "demo:rest": "node src/demo.ts --only=rest",
    "demo:geo": "node src/demo.ts --only=geo",
    "demo:ai": "node src/demo.ts --only=ai",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "web": "pnpm --filter @meridian/web dev",
    "web:build": "pnpm --filter @meridian/web build",
    "verify": "pnpm typecheck && pnpm test && pnpm start && pnpm web:build",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "0.25.12",
    "nodemon": "^3.1.9",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.22.0"
}
