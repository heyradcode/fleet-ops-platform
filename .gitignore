node_modules/
dist/
.env
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
web/dist
.pnpm-store/

# Lambda bundles, produced by `pnpm build:lambda` and zipped by Terraform.
infra/terraform/auth/.build/
infra/terraform/modules/lambda/.build/

# Temp files left behind when terraform init is interrupted mid-write.
.terraform.lock.hcl[0-9]*

# Real variable values - emails, deployment URLs, anything an operator filled in.
# terraform.tfvars.example is the committed record of what is needed.
*.tfvars
!*.tfvars.example
