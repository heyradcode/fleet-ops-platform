node_modules/
dist/
.env
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
web/dist
.pnpm-store/

# Lambda bundles, produced by `pnpm build:lambda` and zipped by Terraform.
infra/terraform/auth/.build/
infra/terraform/modules/lambda/.build/

# Temp files left behind when terraform init is interrupted mid-write.
.terraform.lock.hcl[0-9]*

# Real variable values - emails, deployment URLs, anything an operator filled in.
# terraform.tfvars.example is the committed record of what is needed.
*.tfvars
!*.tfvars.example

# Vite local env overrides. `.env` alone does not cover these, and .env.local
# is exactly where real pool ids and endpoints end up.
.env.local
.env.*.local

# Downloaded IAM access keys. Never commit these.
creds.json
*creds*.json
accessKeys.csv

# Variants like .env.local.cognito - the same real pool ids and endpoints as
# .env.local, under a name the patterns above do not match.
.env.local.*

# Customer engagement material: a CONFIDENTIAL architecture deck, discovery
# notes, and vendor samples with what look like real staff records. Nothing
# real belongs in this repository (CLAUDE.md, "Data"); the code uses these
# files' STRUCTURE only. Kept on disk, never tracked.
docs/nwn/

# The AgentCore agent bundle and its zip, produced by `pnpm build:agent` and
# zipped by Terraform.
infra/terraform/agentcore/.build/

# Local membership rows written by hand for `aws dynamodb put-item`. They name
# a real email domain; they are per-account setup, not source.
infra/terraform/auth/membership.json
infra/terraform/auth/membership/
