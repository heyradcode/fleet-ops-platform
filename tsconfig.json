{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // The Lambda entry point lives under infra/ because it belongs to the
  // deployment rather than the platform - but it is TypeScript that ships,
  // and a file nothing typechecks is a file that breaks in CloudWatch.
  // scripts/*.ts are Node entry points (the mock-vendor server), so they are
  // typechecked here but sit outside src/ and its no-`node:` rule.
  "include": ["src/**/*.ts", "scripts/**/*.ts", "infra/terraform/auth/lambda-entry.ts", "infra/terraform/auth/api-entry.ts"]
}
