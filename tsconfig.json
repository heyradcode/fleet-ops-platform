{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // The Lambda entry point lives under infra/ because it belongs to the
  // deployment rather than the platform - but it is TypeScript that ships,
  // and a file nothing typechecks is a file that breaks in CloudWatch.
  "include": ["src/**/*.ts", "infra/terraform/auth/lambda-entry.ts"]
}
