{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageCostBudgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::588651260734:budget/*"
    }
  ]
}
