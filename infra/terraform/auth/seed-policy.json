{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeedTheMainTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:588651260734:table/netpulse-*-main",
        "arn:aws:dynamodb:us-east-1:588651260734:table/netpulse-*-main/index/GSI1"
      ]
    },
    {
      "Sid": "ArchiveTheCommsPoll",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::netpulse-*-comms-archive-588651260734/comms/*"
      ]
    }
  ]
}
