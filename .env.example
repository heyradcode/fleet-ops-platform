# ---------------------------------------------------------------------------
# The demo runs fully offline with local stand-ins. Nothing here is needed to
# run `pnpm start` - these are the vars the REAL Lambdas would read from
# environment / SSM Parameter Store / Secrets Manager.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
STAGE=dev

# --- Cognito -----------------------------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_ABC123DEF
COGNITO_APP_CLIENT_ID=1h57kf5cpq17m0eml12EXAMPLE
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_ABC123DEF

# The BOARD's copy of the same three, read at build time by Vite. Setting all
# three switches web/src/auth/ from the local issuer to a real user pool, with
# RS256 verification against its published JWKS. Leave them unset and the board
# runs the identical Cognito logic offline - which is the default, not a
# fallback. `terraform output vercel_env` in infra/terraform/auth prints them.
# VITE_COGNITO_DOMAIN=meridian-demo-auth.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=1h57kf5cpq17m0eml12EXAMPLE
# VITE_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_ABC123DEF

# --- Data stores -------------------------------------------------------------
# The hot store: one item per driver, overwritten on every position ping.
TABLE_NAME=meridian-dev-main
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:meridian-dev-aurora
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:111122223333:cluster:meridian-dev
# Raw vendor payloads, archived before normalisation so a mapping bug is
# replayable rather than permanent.
RAW_BUCKET=meridian-dev-raw-111122223333
# The cold path: append-only position history, Firehose -> Parquet -> Athena.
# Kept out of the operational store on purpose - see aws/s3.ts.
HISTORY_BUCKET=meridian-dev-history-111122223333

# --- Ingest stream -----------------------------------------------------------
# Partitioned by driverId: ordering where it matters, parallelism everywhere
# else. Consumed in BATCHES - at 330k drivers a per-record invocation is not a
# viable shape. See aws/kinesis.ts.
KINESIS_STREAM_NAME=meridian-dev-telemetry

# --- Eventing ----------------------------------------------------------------
# Only exceptions and incidents traverse the bus. Telemetry never does.
EVENT_BUS_NAME=meridian-dev-bus
INGEST_STATE_MACHINE_ARN=arn:aws:states:us-east-1:111122223333:stateMachine:meridian-dev-ingest

# --- Bedrock -----------------------------------------------------------------
BEDROCK_TEXT_MODEL_ID=anthropic.claude-opus-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=KB1234EXAMPLE
BEDROCK_GUARDRAIL_ID=gr-1234example

# --- Telematics vendors ------------------------------------------------------
# A carrier runs two or three of these, not all eight - one GPS unit, one ELD,
# and usually one dashcam per truck. Which ones is per-tenant configuration;
# see integrations/registry.ts. In a real deployment these live in Secrets
# Manager and are fetched at cold start, never in a Lambda env var that a stack
# trace can print.

# Telematics: GPS, speed, engine
SAMSARA_API_TOKEN=changeme
GEOTAB_USERNAME=changeme
GEOTAB_PASSWORD=changeme
GEOTAB_DATABASE=changeme
VERIZON_CONNECT_APP_ID=changeme
VERIZON_CONNECT_TOKEN=changeme

# ELD / hours-of-service
MOTIVE_CLIENT_ID=changeme
MOTIVE_CLIENT_SECRET=changeme
OMNITRACS_API_KEY=changeme
OMNITRACS_COMPANY_ID=changeme
PLATFORM_SCIENCE_CLIENT_ID=changeme
PLATFORM_SCIENCE_CLIENT_SECRET=changeme

# Video safety
LYTX_API_KEY=changeme
NETRADYNE_BEARER=changeme

# --- Maps --------------------------------------------------------------------
# OPTIONAL. The dispatch board renders territory polygons and driver pins on a
# dark canvas with MapLibre and needs no token at all. This is only required if
# you swap in real Mapbox tiles, or for the server-side geocoding and isochrone
# calls in geo/mapbox.ts.
# pk.* tokens are safe in the browser but MUST be URL-restricted in the Mapbox
# dashboard. sk.* tokens are server-only and belong in Secrets Manager.
MAPBOX_ACCESS_TOKEN=
