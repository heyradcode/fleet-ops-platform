# ---------------------------------------------------------------------------
# The demo runs fully offline with fakes. These are the vars the REAL Lambdas
# would read from environment / SSM Parameter Store / Secrets Manager.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
STAGE=dev

# --- Cognito -----------------------------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_ABC123DEF
COGNITO_APP_CLIENT_ID=1h57kf5cpq17m0eml12EXAMPLE
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_ABC123DEF

# --- Data stores -------------------------------------------------------------
TABLE_NAME=netpulse-dev-main
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:netpulse-dev-aurora
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:111122223333:cluster:netpulse-dev
RAW_BUCKET=netpulse-dev-raw-111122223333

# --- Eventing ----------------------------------------------------------------
EVENT_BUS_NAME=netpulse-dev-bus
INGEST_STATE_MACHINE_ARN=arn:aws:states:us-east-1:111122223333:stateMachine:netpulse-dev-ingest

# --- Bedrock -----------------------------------------------------------------
BEDROCK_TEXT_MODEL_ID=anthropic.claude-opus-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=KB1234EXAMPLE
BEDROCK_GUARDRAIL_ID=gr-1234example

# --- Third-party integrations (real deployments: Secrets Manager, not env) ----
MERAKI_API_KEY=changeme
MIST_API_TOKEN=changeme
ARUBA_CENTRAL_TOKEN=changeme
GENESYS_CLIENT_ID=changeme
GENESYS_CLIENT_SECRET=changeme
FIVE9_USERNAME=changeme
FIVE9_PASSWORD=changeme
THOUSANDEYES_BEARER=changeme
SPLUNK_HEC_TOKEN=changeme
MAPBOX_ACCESS_TOKEN=pk.changeme
